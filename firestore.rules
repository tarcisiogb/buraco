rules_version = '2';

// =====================================================================
// BURACO DA FAMILIA — Regras do Firestore
// jogadores: cadastro self-service (pendente) -> Master aprova.
// Perfis: master | jogador.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function meDoc()     { return get(/databases/$(database)/documents/jogadores/$(request.auth.uid)).data; }
    function isApproved(){ return signedIn() && meDoc().status == 'aprovado'; }
    function isMaster()  { return signedIn() && meDoc().role == 'master' && meDoc().status == 'aprovado'; }

    match /jogadores/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isApproved());

      // Auto-cadastro: sempre pendente e perfil jogador.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.role == 'jogador';

      // O proprio jogador edita so os dados de perfil.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nome', 'apelido', 'telefone', 'foto', 'relacao']);

      // Master aprova, recusa, edita e remove.
      allow update, delete: if isMaster();
    }

    // Partidas concluidas (ranking): quem jogou registra uma vez; so o Master apaga.
    match /partidas/{pid} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.jogadores.size() == 4
        && request.auth.uid in request.resource.data.jogadores;
      allow update: if false;
      allow delete: if isMaster();
    }

    // Partidas de Faroeste (4 a 7 jogadores)
    match /partidasFaroeste/{pid} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.jogadores.size() >= 4
        && request.resource.data.jogadores.size() <= 7
        && request.auth.uid in request.resource.data.jogadores;
      allow update: if false;
      allow delete: if isMaster();
    }

    // Partidas de Blackjack (1 a 6 jogadores, incluindo bots)
    match /partidasBlackjack/{pid} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.jogadores.size() >= 1
        && request.resource.data.jogadores.size() <= 6
        && request.auth.uid in request.resource.data.jogadores;
      allow update: if false;
      allow delete: if isMaster();
    }

    // Mesas de jogo: qualquer jogador aprovado cria, senta e le.
    match /mesas/{mid} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.status == 'aguardando';
      allow update: if isApproved()
        && (resource.data.status == 'aguardando'
            || request.auth.uid in resource.data.seats
            || isMaster()
            // Blackjack: um jogador aprovado pode assumir o lugar de um bot no meio da partida
            || (resource.data.jogo == 'blackjack'
                && resource.data.status == 'jogando'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'jogadores'])
                && request.auth.uid in request.resource.data.seats
                && request.resource.data.seats.size() == resource.data.seats.size()));
      allow delete: if isApproved()
        && (resource.data.criadoPor == request.auth.uid || isMaster());

      // Estado da partida (JSON do engine): so quem esta sentado escreve.
      match /estado/{doc} {
        allow read: if isApproved();
        allow write: if isApproved()
          && (request.auth.uid in get(/databases/$(database)/documents/mesas/$(mid)).data.seats
              || isMaster()
              || get(/databases/$(database)/documents/mesas/$(mid)).data.criadoPor == request.auth.uid
              // quem acabou de assumir um lugar de bot no Blackjack (na mesma transação)
              || (getAfter(/databases/$(database)/documents/mesas/$(mid)).data.jogo == 'blackjack'
                  && request.auth.uid in getAfter(/databases/$(database)/documents/mesas/$(mid)).data.seats));
      }
    }
  }
}
